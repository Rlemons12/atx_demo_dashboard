          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.asset_code AS \"Asset\", f.failure_mode AS \"Failure Mode\", count(*) AS \"Events\", round(sum(EXTRACT(epoch FROM (COALESCE(d.downtime_end, now()) - d.downtime_start))/60.0), 0) AS \"Total Downtime (min)\", CASE WHEN count(*) FILTER (WHERE f.repeat_failure) > 0 THEN 'Repeat Problem' ELSE 'Single Event' END AS \"Repeat Indicator\" FROM failure_events f JOIN assets a USING(asset_id) LEFT JOIN downtime_events d USING(work_order_id) WHERE ('$asset' = '%' OR a.asset_code = '$asset') GROUP BY a.asset_code, f.failure_mode HAVING count(*) > 1 ORDER BY count(*) DESC",
