          "rawSql": "SELECT p.product_code AS \"SKU\", p.product_name AS \"Product Name\", l.line_code AS \"Line\", pls.ideal_units_per_minute AS \"Ideal Rate (Units/Min)\", pls.expected_yield_pct AS \"Expected Yield (%)\", pls.standard_changeover_minutes AS \"Std Changeover (Min)\" FROM product_line_standards pls JOIN products p USING(product_id) JOIN production_lines l USING(line_id) WHERE ('$line' = '%' OR l.line_code = '$line') AND ('$product' = '%' OR p.product_code = '$product') ORDER BY l.line_code, p.product_code",
