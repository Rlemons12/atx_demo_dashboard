        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "atx-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT skill AS \"Skill Area\", shift_a_level AS \"Shift A Level\", shift_b_level AS \"Shift B Level\", independently_qualified AS \"Independent Techs (Level 3+)\", CASE WHEN critical_skill THEN 'Yes' ELSE 'No' END AS \"Critical Skill\" FROM v_technician_skill_coverage ORDER BY skill",
          "refId": "A"
        }
      ],
      "title": "Maintenance Technician Skills Matrix",
      "type": "table"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "atx-postgres" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 12,
      "options": { "footer": { "show": false }, "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "atx-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sk.name AS \"Skill Area\", count(*) FILTER (WHERE es.proficiency_level >= 3) AS \"Qualified Techs (Level 3+)\", max(es.proficiency_level) FILTER (WHERE s.name='Production Shift A') AS \"Shift A Max Level\", max(es.proficiency_level) FILTER (WHERE s.name='Production Shift B') AS \"Shift B Max Level\", CASE WHEN count(*) FILTER (WHERE es.proficiency_level >= 3) >= 2 THEN 'Full Coverage' WHEN count(*) FILTER (WHERE es.proficiency_level >= 3) = 1 THEN 'Single Tech Risk' ELSE 'Coverage Gap' END AS \"Risk Assessment\" FROM skills sk LEFT JOIN employee_skills es USING(skill_id) LEFT JOIN employee_shift_assignments esa ON esa.employee_id=es.employee_id AND esa.is_primary AND esa.effective_to IS NULL LEFT JOIN shifts s USING(shift_id) WHERE sk.critical_skill GROUP BY sk.skill_id, sk.name ORDER BY sk.name",
          "refId": "A"
        }
      ],
      "title": "Critical Equipment Skill Coverage & Single-Point Risks",
      "type": "table"
    },
