          "rawSql": "SELECT sf.reported_at::date AS \"Date\", a.asset_code AS \"Asset\", sf.description AS \"Finding Description\", sf.priority AS \"Priority\", CASE WHEN sf.maintenance_required THEN 'Yes' ELSE 'No' END AS \"Maint Req\", CASE WHEN sf.startup_risk THEN 'Yes' ELSE 'No' END AS \"Startup Risk\", COALESCE(w.work_order_number, 'None') AS \"Work Order\", sf.status AS \"Status\" FROM sanitation_findings sf JOIN assets a USING(asset_id) LEFT JOIN work_orders w USING(work_order_id) WHERE sf.status NOT IN ('RESOLVED', 'CLOSED') ORDER BY sf.startup_risk DESC, sf.reported_at DESC",
