# Neon project linkage (IDs are configuration, not secrets)
NEON_ORG_ID=org_replace_me
NEON_PROJECT_ID=replace_me
NEON_BRANCH_ID=br_replace_me

# Neon Lakebase Postgres
# Use the pooled URL for application traffic and the direct URL for migrations,
# schema loading, pg_dump, and other session-level operations.
DATABASE_URL=postgresql://user:password@endpoint-pooler.region.aws.neon.tech/atx_demo_dashboard?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.region.aws.neon.tech/atx_demo_dashboard?sslmode=require

# Grafana's PostgreSQL datasource currently consumes the decomposed values.
# These must describe the same database and role as DATABASE_URL.
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST=endpoint-pooler.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=atx_demo_dashboard
POSTGRES_SCHEMA=public

# Grafana configuration
GRAFANA_URL=http://127.0.0.1:3001
GRAFANA_SERVICE_ACCOUNT_TOKEN=replace_me

# Optional: enables the dashboard's AI-generated summary.
OPENAI_API_KEY=replace_me
NEON_POSTGRESQL=replace_me
PGUSER=replace_me
PGPASSWORD=replace_me